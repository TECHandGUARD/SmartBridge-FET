# Browser-visible build settings. Copy to .env.local; never put server secrets here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Legacy anon JWT alternative; leave blank when using a publishable key.
VITE_SUPABASE_ANON_KEY=
# Optional: defaults to the current browser origin, keeping staging separate.
VITE_APP_BASE_URL=

# Optional payment methods. Blank means unavailable. Use approved Yoco merchant URLs.
VITE_YOCO_STUDENT_URL=
VITE_YOCO_PARENT_URL=
VITE_YOCO_TUTOR_PRO_URL=
VITE_STUDENT_MONTHLY_PRICE=20
VITE_PARENT_MONTHLY_PRICE=50
VITE_TUTOR_PRO_MONTHLY_PRICE=150
# Public business payment details only. Set all four to enable EFT.
VITE_EFT_BANK_NAME=
VITE_EFT_ACCOUNT_NAME=
VITE_EFT_ACCOUNT_NUMBER=
VITE_EFT_BRANCH_CODE=

VITE_COMPANY_NAME=Tech & GUARD Pty Ltd
VITE_CIPC_REGISTRATION=2026/15509/07
VITE_REGISTRATION_DATE=21 February 2026
VITE_SUPPORT_EMAIL=aneleq@techandguard.co.za
VITE_CORPORATE_WEBSITE=https://www.techandguard.co.za
VITE_CORPORATE_LOGO_URL=

# Enable only after the payment migration, server secrets and webhooks pass staging checks.
VITE_PAYMENTS_API_ENABLED=false

# Optional existing UI customization settings
