{
  "name": "StudentNote",
  "type": "object",
  "properties": {
    "tutor_email": {
      "type": "string"
    },
    "student_email": {
      "type": "string"
    },
    "student_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "note": {
      "type": "string",
      "description": "Session note or progress observation"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "strengths": {
      "type": "string",
      "description": "What the student did well"
    },
    "areas_to_improve": {
      "type": "string",
      "description": "Topics needing more work"
    },
    "next_steps": {
      "type": "string",
      "description": "Planned follow-up or homework"
    },
    "mood": {
      "type": "string",
      "enum": [
        "Engaged",
        "Struggling",
        "Distracted",
        "Confident",
        "Neutral"
      ],
      "default": "Neutral"
    }
  },
  "required": [
    "tutor_email",
    "student_email",
    "note"
  ],
  "rls": {
    "create": {
      "data.tutor_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.tutor_email": "{{user.email}}"
        },
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.student_email": "{{user.data.linked_student_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.tutor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.tutor_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}