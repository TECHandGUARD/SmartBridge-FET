{
  "name": "ApplicationDocument",
  "type": "object",
  "properties": {
    "application_id": {
      "type": "string",
      "description": "ID of the UniversityApplication"
    },
    "student_email": {
      "type": "string"
    },
    "university_name": {
      "type": "string"
    },
    "doc_type": {
      "type": "string",
      "enum": [
        "ID Copy",
        "Matric Certificate",
        "Proof of Payment",
        "NBT Results",
        "Academic Transcript",
        "Motivation Letter",
        "Reference Letter",
        "Other"
      ],
      "description": "Type of document"
    },
    "file_url": {
      "type": "string"
    },
    "file_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "uploaded",
        "submitted",
        "verified",
        "rejected"
      ],
      "default": "uploaded"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "application_id",
    "student_email",
    "doc_type",
    "file_url"
  ],
  "rls": {
    "create": {
      "data.student_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "counselor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "counselor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "counselor"
          }
        }
      ]
    }
  }
}