{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "ChatMessage",
  "type": "object",
  "description": "Chat message between users in the SmartBridge FET platform",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "description": "Primary key - auto-generated UUID"
    },
    "room_id": {
      "type": "string",
      "maxLength": 255,
      "description": "Unique identifier for the chat room (e.g., email1__email2)"
    },
    "sender_email": {
      "type": "string",
      "format": "email",
      "maxLength": 255,
      "description": "Email of the message sender"
    },
    "sender_name": {
      "type": "string",
      "maxLength": 255,
      "description": "Display name of the sender"
    },
    "recipient_email": {
      "type": "string",
      "format": "email",
      "maxLength": 255,
      "description": "Email of the message recipient"
    },
    "content": {
      "type": "string",
      "maxLength": 5000,
      "description": "Message content"
    },
    "read": {
      "type": "boolean",
      "default": false,
      "description": "Whether the message has been read by the recipient"
    },
    "read_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the message was read"
    },
    "attachment_url": {
      "type": "string",
      "maxLength": 500,
      "description": "URL to attached file"
    },
    "attachment_type": {
      "type": "string",
      "maxLength": 100,
      "description": "MIME type of the attachment"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the message was created"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when the message was last updated"
    }
  },
  "required": ["room_id", "sender_email", "content"],
  "additionalProperties": false
}
