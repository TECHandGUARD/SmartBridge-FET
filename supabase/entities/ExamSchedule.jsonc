{
  "name": "ExamSchedule",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "grade": {
      "type": "string",
      "enum": [
        "Grade 10",
        "Grade 11",
        "Grade 12"
      ]
    },
    "exam_date": {
      "type": "string",
      "format": "date"
    },
    "exam_type": {
      "type": "string",
      "enum": [
        "Test",
        "Mid-Year Exam",
        "Trial Exam",
        "Final Exam",
        "Assignment",
        "Oral"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "student_email",
    "subject",
    "grade",
    "exam_date",
    "exam_type"
  ],
  "rls": {
    "create": {
      "data.student_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.student_email": "{{user.data.linked_student_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "counselor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}