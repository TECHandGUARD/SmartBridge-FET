{
  "name": "UniversityApplication",
  "type": "object",
  "properties": {
    "student_email": {
      "type": "string"
    },
    "university_name": {
      "type": "string"
    },
    "application_link": {
      "type": "string"
    },
    "faculty": {
      "type": "string"
    },
    "course": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "Saved",
        "Started",
        "Submitted",
        "Pending NBT",
        "Accepted",
        "Rejected",
        "Waitlisted"
      ],
      "default": "Saved"
    },
    "notes": {
      "type": "string"
    },
    "deadline": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "student_email",
    "university_name",
    "stage"
  ],
  "rls": {
    "create": {
      "data.student_email": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "data.student_email": "{{user.data.linked_student_email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "counselor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.student_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}