{
  "name": "ResourceRating",
  "type": "object",
  "properties": {
    "resource_id": {
      "type": "string"
    },
    "user_email": {
      "type": "string"
    },
    "rating": {
      "type": "number"
    },
    "comment": {
      "type": "string"
    }
  },
  "required": [
    "resource_id",
    "user_email",
    "rating"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {},
    "update": {
      "data.user_email": "{{user.email}}"
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}