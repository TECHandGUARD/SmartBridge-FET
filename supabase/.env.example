# Server-only settings; configure in the target Supabase Edge Function secrets.
# Hosted Supabase supplies SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY.
APP_BASE_URL=
GEMINI_API_KEY=
# Select an available Google model ID; there is no retired fallback.
GEMINI_MODEL=
RESEND_API_KEY=
# Verified sender: Name <address@verified-domain.example> or a bare address.
EMAIL_FROM=
# Strong random secret for authenticated webhook/scheduler calls (x-job-secret).
JOB_AUTH_SECRET=
# Existing deployments may retain APP_URL, FROM_EMAIL, DB_URL, SERVICE_ROLE_KEY.
# Canonical names above take precedence. Never put these credentials in VITE_*.

# One-off Yoco checkout; off until staging verification and merchant configuration.
PAYMENTS_API_ENABLED=false
YOCO_MODE=test
YOCO_SECRET_KEY=
YOCO_WEBHOOK_SECRET=
# Server prices are authoritative; keep frontend displays consistent.
PAYMENT_STUDENT_AMOUNT_CENTS=2000
PAYMENT_PARENT_AMOUNT_CENTS=5000
PAYMENT_TUTOR_PRO_AMOUNT_CENTS=15000

# Signed delivery/bounce/complaint callbacks, configured in the Resend dashboard.
RESEND_WEBHOOK_SECRET=

# Optional separate credentials for each gateway/mode. Admin settings hold no secrets.
# Existing YOCO_SECRET_KEY/YOCO_WEBHOOK_SECRET remain supported for YOCO_MODE.
YOCO_TEST_SECRET_KEY=
YOCO_TEST_WEBHOOK_SECRET=
YOCO_LIVE_SECRET_KEY=
YOCO_LIVE_WEBHOOK_SECRET=
# Paystack uses its secret key for webhook signing; no account is required while disabled.
PAYSTACK_TEST_SECRET_KEY=
PAYSTACK_LIVE_SECRET_KEY=

# Activate after migration six and staging verification.
SERVER_MONITORING_ENABLED=false
# Set true only after the native scheduler/Vault configuration is installed and verified.
SCHEDULER_READY=false
