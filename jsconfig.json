{
  "compilerOptions": {
    // ============================================================
    // PATHS & ALIASES
    // ============================================================
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },

    // ============================================================
    // JAVASCRIPT / REACT
    // ============================================================
    "jsx": "react-jsx",
    "checkJs": true,

    // ============================================================
    // MODULE RESOLUTION
    // ============================================================
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,

    // ============================================================
    // TARGET & LIBRARIES
    // ============================================================
    "target": "esnext",
    "lib": ["esnext", "dom", "dom.iterable"],

    // ============================================================
    // TYPE CHECKING
    // ============================================================
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "allowJs": true,
    "noEmit": true,

    // ============================================================
    // STRICT MODE (Optional - uncomment for stricter checks)
    // ============================================================
    // "strict": true,
    // "noUnusedLocals": true,
    // "noUnusedParameters": true,
    // "noImplicitReturns": true,

    // ============================================================
    // TYPES
    // ============================================================
    "types": ["vite/client", "node"]
  },

  // ============================================================
  // INCLUDE - All source files
  // ============================================================
  "include": [
    "src/**/*.js",
    "src/**/*.jsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.json",
    "src/**/*.d.ts"
  ],

  // ============================================================
  // EXCLUDE - Build and dependency files
  // ============================================================
  "exclude": [
    "node_modules",
    "dist",
    "build",
    ".vite",
    "coverage",
    "**/*.test.js",
    "**/*.spec.js"
  ]
}
